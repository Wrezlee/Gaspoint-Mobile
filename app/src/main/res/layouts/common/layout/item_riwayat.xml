<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#FFFFFF"
    android:layout_marginBottom="12dp"
    android:layout_marginHorizontal="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <View
            android:id="@+id/stripStatus"
            android:layout_width="6dp"
            android:layout_height="match_parent"
            android:background="#00B894" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="16dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp">

                <TextView
                    android:id="@+id/tvIdRiwayat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:text="#ORD-2041"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#9BA3AE" />

                <TextView
                    android:id="@+id/tvKeteranganStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:background="@drawable/bg_badge_status"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="5dp"
                    android:text="✓ Berhasil Diantarkan"
                    android:textColor="#00B894"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <TextView
                android:id="@+id/tvNamaPembeli"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rizky Pratama"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#2D3436" />

            <TextView
                android:id="@+id/tvItemPesanan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Nasi Goreng Spesial × 2"
                android:textSize="13sp"
                android:textColor="#636E72" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="12dp"
                android:background="#F1F2F6" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@android:drawable/ic_menu_recent_history"
                    app:tint="#B2BEC3" />

                <TextView
                    android:id="@+id/tvWaktuRiwayat"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="14 Apr 2026 · 10:32"
                    android:textSize="12sp"
                    android:textColor="#B2BEC3" />

                <TextView
                    android:id="@+id/tvNominal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rp 45.000"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#0984E3" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>